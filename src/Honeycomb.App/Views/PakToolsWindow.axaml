<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Honeycomb.App.ViewModels"
        xmlns:conv="using:Honeycomb.App.Converters"
        x:Class="Honeycomb.App.Views.PakToolsWindow"
        x:DataType="vm:PakToolsViewModel"
        Title="PAK Tools"
        Width="620"
        Height="420"
        MinWidth="540"
        MinHeight="380"
        Icon="/Assets/honeycomb.ico"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:IndexToBoolConverter x:Key="IdxToBool" />
    </Window.Resources>

    <TabControl Margin="8">

        <TabItem Header="Extract">
            <StackPanel Spacing="8" Margin="10">
                <TextBlock Text="PAK File or Folder Containing PAK Files" />
                <Grid ColumnDefinitions="*,70">
                    <TextBox Text="{Binding PakFileOrFolder}" />
                    <Button Grid.Column="1" Content="Open" Command="{Binding OpenPakCommand}" Margin="6,0,0,0" />
                </Grid>
                <CheckBox Content="Don't convert .qb files to text" IsChecked="{Binding ConvertQ}" />
                <Button Content="Extract" Command="{Binding ExtractCommand}" IsEnabled="{Binding IsExtracting, Converter={x:Static BoolConverters.Not}}" HorizontalAlignment="Left" MinWidth="120" />
            </StackPanel>
        </TabItem>

        <TabItem Header="Compile">
            <StackPanel Spacing="8" Margin="10">
                <TextBlock Text="Extract Folder" />
                <Grid ColumnDefinitions="*,70">
                    <TextBox Text="{Binding FolderToCompile}" />
                    <Button Grid.Column="1" Content="Select" Command="{Binding SelectFolderCommand}" Margin="6,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="100,*,150">
                    <TextBlock Text="Save Location:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SaveLocation}" IsReadOnly="True" />
                    <TextBlock Grid.Column="2" Text="" />
                </Grid>

                <Border BorderBrush="#888" BorderThickness="1" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Console" FontWeight="SemiBold" />
                        <RadioButton Content="360/PC" GroupName="pakConsole" IsChecked="{Binding ConsoleIndex, Converter={StaticResource IdxToBool}, ConverterParameter=0}" />
                        <RadioButton Content="PS3" GroupName="pakConsole" IsChecked="{Binding ConsoleIndex, Converter={StaticResource IdxToBool}, ConverterParameter=1}" />
                        <RadioButton Content="PS2" GroupName="pakConsole" IsChecked="{Binding ConsoleIndex, Converter={StaticResource IdxToBool}, ConverterParameter=2}" />
                        <RadioButton Content="Wii" GroupName="pakConsole" IsChecked="{Binding ConsoleIndex, Converter={StaticResource IdxToBool}, ConverterParameter=3}" />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                    <TextBlock Text="Game:" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding GameOptions}" SelectedItem="{Binding Game}" Margin="6,0" />
                    <CheckBox Grid.Column="2" Content="Split PAB" IsChecked="{Binding SplitPab}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="3" Content="Set Asset Context" IsChecked="{Binding SetAssetContext}" Margin="6,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="4" Text="{Binding AssetContext}" IsEnabled="{Binding SetAssetContext}" Width="140" />
                </Grid>

                <Button Content="Compile" Command="{Binding CompileCommand}" IsEnabled="{Binding IsCompiling, Converter={x:Static BoolConverters.Not}}" HorizontalAlignment="Left" MinWidth="120" />
            </StackPanel>
        </TabItem>

    </TabControl>

</Window>
