<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Honeycomb.App.Views.MessageDialog"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="14">
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   FontSize="13" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="NoButton" Content="No" IsVisible="False" MinWidth="80" />
            <Button x:Name="YesButton" Content="OK" IsVisible="False" MinWidth="80" />
            <Button x:Name="CancelButton" Content="Cancel" IsVisible="False" MinWidth="80" />
        </StackPanel>
    </StackPanel>

</Window>
