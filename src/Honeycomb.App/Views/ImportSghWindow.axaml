<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Honeycomb.App.ViewModels"
        x:Class="Honeycomb.App.Views.ImportSghWindow"
        x:DataType="vm:ImportSghViewModel"
        Title="Import SGH Archive"
        Width="460"
        Height="520"
        MinWidth="400"
        MinHeight="420"
        Icon="/Assets/honeycomb.ico"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="Console:" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ConsoleOptions}" SelectedIndex="{Binding ConsoleIndex}" Margin="8,0" HorizontalAlignment="Left" MinWidth="120" />
            <Button Grid.Column="2" Content="Convert!" Command="{Binding ConvertCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" Background="#6b8e23" Foreground="White" MinWidth="110" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <Button Content="Import SGH File" Command="{Binding ImportSghCommand}" HorizontalAlignment="Left" MinWidth="140" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Select All" Command="{Binding SelectAllCommand}" />
                <Button Content="Select None" Command="{Binding SelectNoneCommand}" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="#888" BorderThickness="1" CornerRadius="4" Margin="0,8">
            <ListBox x:Name="SongList" ItemsSource="{Binding Songs}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding DisplayName}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>

</Window>
