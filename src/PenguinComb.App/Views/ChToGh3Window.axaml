<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PenguinComb.App.ViewModels"
        x:Class="PenguinComb.App.Views.ChToGh3Window"
        x:DataType="vm:ChToGh3ViewModel"
        Title="Clone Hero to Better GH3"
        Width="640"
        Height="500"
        MinWidth="560"
        MinHeight="400"
        Icon="/Assets/penguincomb.ico"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            <ProgressBar Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" Height="8" />

            <WrapPanel Orientation="Horizontal">
                <Button Content="Add Songs..." Command="{Binding AddSongsCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" Margin="0,0,6,4" />
                <Button Content="Add Library Folder..." Command="{Binding AddLibraryCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" Margin="0,0,6,4" />
                <Button Content="Remove" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" Margin="0,0,6,4" />
                <Button Content="Clear" Command="{Binding ClearCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" Margin="0,0,6,4" />
                <Button Content="Convert to Better GH3" Classes="accent" Command="{Binding CompileCommand}" Margin="0,0,6,4" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Margin="0,0,6,4" />
            </WrapPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
            <TextBlock Text="1) Add your Clone Hero songs.  2) Point at your GH3 game folder.  3) Press Convert." TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="GH3 folder:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Gh3Folder}" IsReadOnly="True" Margin="8,0" />
                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseGh3FolderCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
            </Grid>
        </StackPanel>

        <Border BorderBrush="#888" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding Songs}"
                     SelectedItem="{Binding SelectedSong}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,100,*" Margin="2">
                            <TextBlock Text="{Binding SongName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding Error}" VerticalAlignment="Center" Foreground="#b22222"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Error}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</Window>
