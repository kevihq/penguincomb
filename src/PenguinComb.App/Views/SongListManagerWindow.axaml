<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PenguinComb.App.ViewModels"
        x:Class="PenguinComb.App.Views.SongListManagerWindow"
        x:DataType="vm:SongListManagerViewModel"
        Title="Song List Manager"
        Width="640"
        Height="620"
        MinWidth="560"
        MinHeight="520"
        Icon="/Assets/penguincomb.ico"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,20,Auto,*,Auto" Margin="0,0,0,8">
            <Border BorderBrush="#888" BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Game" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <RadioButton Content="GH3" GroupName="slmGame" IsChecked="{Binding IsGh3}" IsEnabled="{Binding GameSelectionEnabled}" />
                    <RadioButton Content="GHA" GroupName="slmGame" IsChecked="{Binding IsGh3, Converter={x:Static BoolConverters.Not}}" IsEnabled="{Binding GameSelectionEnabled}" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Column="1" />
            <TextBlock Grid.Column="2" Text="Console:" VerticalAlignment="Center" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding ConsoleOptions}" SelectedIndex="{Binding ConsoleIndex}" Margin="6,0" HorizontalAlignment="Left" MinWidth="110" />
        </Grid>

        <TabControl DockPanel.Dock="Bottom" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,8">

            <TabItem Header="Import">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                        <Button Content="Import Selected to Game" Command="{Binding ConvertSongsCommand}" IsEnabled="{Binding ImportEnabled}" Background="#6b8e23" Foreground="White" HorizontalAlignment="Stretch" Height="36" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6">
                        <Button Content="Select SGH File" Command="{Binding ImportSghFileCommand}" IsEnabled="{Binding ImportEnabled}" HorizontalAlignment="Left" MinWidth="140" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Select All" Command="{Binding SelectAllCommand}" />
                            <Button Content="Select None" Command="{Binding SelectNoneCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="#888" BorderThickness="1" CornerRadius="4" Margin="0,8">
                        <ListBox ItemsSource="{Binding Songs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Export">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                        <Button Content="Export Selected Songs to SGH File" Command="{Binding ExportToSghCommand}" IsEnabled="{Binding ExportEnabled}" Background="#6b8e23" Foreground="White" HorizontalAlignment="Stretch" Height="36" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6">
                        <Button Content="Load Setlist" Command="{Binding LoadSetlistCommand}" IsEnabled="{Binding ExportEnabled}" HorizontalAlignment="Left" MinWidth="140" />
                    </StackPanel>
                    <Border BorderBrush="#888" BorderThickness="1" CornerRadius="4" Margin="0,8">
                        <ListBox ItemsSource="{Binding Songs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Delete">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                        <Button Content="Delete Selected" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding DeleteEnabled}" Background="#b22222" Foreground="White" HorizontalAlignment="Stretch" Height="36" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6">
                        <Button Content="Load Setlist" Command="{Binding LoadSetlistCommand}" IsEnabled="{Binding DeleteEnabled}" HorizontalAlignment="Left" MinWidth="140" />
                    </StackPanel>
                    <Border BorderBrush="#888" BorderThickness="1" CornerRadius="4" Margin="0,8">
                        <ListBox ItemsSource="{Binding Songs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Restore">
                <StackPanel Spacing="10" Margin="10">
                    <TextBlock Text="The original setlist contains only on-disc songs. Restoring it removes all custom songs from the game." TextWrapping="Wrap" />
                    <Button Content="Click Here to Restore the Original DLC Setlist (Removes all customs)" Command="{Binding RestoreSetlistCommand}" HorizontalAlignment="Stretch" Height="44" />
                </StackPanel>
            </TabItem>

        </TabControl>

    </DockPanel>

</Window>
