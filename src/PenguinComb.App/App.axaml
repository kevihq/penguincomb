<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PenguinComb.App.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />

        <!-- =====================================================================
             Primary action button (green accent). Apply with Classes="accent".
             Makes the main compile action clearly stand out from the other tools.
        ===================================================================== -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#5E8B23" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18,10" />
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="#6FA52B" />
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="Background" Value="#4D731C" />
        </Style>
        <Style Selector="Button.accent:disabled">
            <Setter Property="Background" Value="#8A9A6B" />
            <Setter Property="Foreground" Value="#EAEAEA" />
        </Style>

        <!-- =====================================================================
             Tabs: give every tab header a clear, button-like look so users can
             tell at a glance that the row of buttons switches between sections.
        ===================================================================== -->
        <Style Selector="TabControl > TabItem">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border x:Name="TabHeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Header}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="TabControl > TabItem:pointerover">
            <Setter Property="Background" Value="#00000020" />
        </Style>
        <Style Selector="TabControl > TabItem:selected">
            <Setter Property="Background" Value="#6B8E23" />
            <Setter Property="BorderBrush" Value="#6B8E23" />
            <Setter Property="Foreground" Value="White" />
        </Style>

    </Application.Styles>

</Application>
