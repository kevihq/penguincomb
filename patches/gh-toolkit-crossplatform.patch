+        /// <summary>
+        /// Converts a WAV file to 16-bit stereo PCM at the requested sample rate using only
+        /// managed NAudio providers (no Windows Media Foundation dependency).
+        /// </summary>
+        private static IWaveProvider ResampleToTargetFormat(WaveFileReader source, int sampleRate)
+        {
+            ISampleProvider samples;
+            if (source.WaveFormat.Encoding == WaveFormatEncoding.IeeeFloat)
+            {
+                samples = new FloatWaveToSampleProvider(source);
+            }
+            else if (source.WaveFormat.BitsPerSample == 24)
+            {
+                samples = new Pcm24BitToSampleProvider(source);
+            }
+            else if (source.WaveFormat.BitsPerSample == 32)
+            {
+                samples = new Pcm32BitToSampleProvider(source);
+            }
+            else
+            {
+                samples = new Pcm16BitToSampleProvider(source);
+            }
+
+            if (samples.WaveFormat.Channels == 1)
+            {
+                samples = samples.ToStereo();
+            }
+
+            if (samples.WaveFormat.SampleRate != sampleRate)
+            {
+                samples = new WdlResamplingSampleProvider(samples, sampleRate);
+            }
+
+            return new SampleToWaveProvider16(samples);
+        }
+
+        /// <summary>
+        /// Minimal managed IEEE-float WAV to sample-provider adapter (NAudio has no built-in
+        /// converter that accepts an arbitrary IWaveProvider).
+        /// </summary>
+        private sealed class FloatWaveToSampleProvider : ISampleProvider
+        {
+            private readonly IWaveProvider _source;
+            private readonly byte[] _buffer;
+            public WaveFormat WaveFormat { get; }
+
+            public FloatWaveToSampleProvider(IWaveProvider source)
+            {
+                _source = source;
+                WaveFormat = new WaveFormat(source.WaveFormat.SampleRate, 32, source.WaveFormat.Channels);
+                _buffer = new byte[4096 * 4];
+            }
+
+            public int Read(float[] buffer, int offset, int count)
+            {
+                int bytesNeeded = count * 4;
+                int bytesRead = _source.Read(_buffer, 0, bytesNeeded);
+                int samplesRead = bytesRead / 4;
+                for (int i = 0; i < samplesRead; i++)
+                {
+                    buffer[offset + i] = BitConverter.ToSingle(_buffer, i * 4);
+                }
+                return samplesRead;
+            }
+        }
